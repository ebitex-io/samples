@model PresentationEnvelope
@{
    // The same `statement` Contract as `hero`, rendered as a quiet section rather than a banner: an
    // h2 rather than an h1, no tinted band, and a plain link instead of a button.
    var content = Model.Content();
    var heading = content.Text("heading");
    var standfirst = content.Text("standfirst");
    var cta = content.Link("cta");
    var ctaLabel = content.Text("cta-label");
}

<section class="mx-auto max-w-3xl px-6 py-12">
    @if (heading is { Length: > 0 })
    {
        <h2 class="font-display text-2xl text-ink">@heading</h2>
    }

    @if (standfirst is { Length: > 0 })
    {
        <p class="mt-3 text-ink-muted">@standfirst</p>
    }

    <div class="[&_p]:mt-4 [&_p]:text-ink-muted [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:text-ink-muted [&_a]:text-accent [&_a]:underline [&_strong]:text-ink">
        @await Html.RichTextAsync(content.Field("body"))
    </div>

    @if (ctaLabel is { Length: > 0 } && cta?.Url is { Length: > 0 } href)
    {
        <p class="mt-6">
            <a class="text-accent underline" href="@href">@ctaLabel</a>
        </p>
    }
</section>
