@model PresentationEnvelope
@{
    var content = Model.Content();
    var heading = content.Text("heading");

    // An authored list, not a query: the author chose these guides and their order. The catalogue page
    // is the opposite — a stream, ordered by the CMS — and the two sit side by side in this sample on
    // purpose, because which one a page wants is a content-modelling decision rather than a technical
    // one.
    var guides = content.Components("guides");
}

<section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="font-display text-3xl text-ink">@heading</h1>

    <div class="mt-4 [&_p]:mt-3 [&_p]:text-ink-muted [&_a]:text-accent [&_a]:underline">
        @await Html.RichTextAsync(content.Field("intro"))
    </div>

    <ul class="mt-10 divide-y divide-line border-y border-line">
        @foreach (var guide in guides)
        {
            var fields = guide.IsResolved ? guide.Content : null;
            var title = fields.Text("heading");
            var summary = fields.Text("summary");
            var minutes = fields.Number("total-time");
            var href = guide.PathFor();

            <li class="py-5">
                <h2 class="font-display text-xl text-ink">
                    @if (href is { Length: > 0 })
                    {
                        <a class="underline decoration-line underline-offset-4" href="@href">@title</a>
                    }
                    else
                    {
                        @title
                    }
                </h2>

                @if (summary is { Length: > 0 })
                {
                    <p class="mt-2 text-ink-muted">@summary</p>
                }

                @if (minutes is { } value)
                {
                    <p class="mt-2 text-sm text-ink-muted">@($"{value:0.##} min")</p>
                }
            </li>
        }
    </ul>
</section>
