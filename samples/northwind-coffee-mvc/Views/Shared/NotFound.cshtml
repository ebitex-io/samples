@{
    ViewData["Title"] = "Page not found";
    Layout = "_Layout";
}

@* A real 404: the status code is set by the controller, not implied by rendering this view. A page
   that looks missing while answering 200 is worse than one that is missing, because nothing
   downstream — a crawler, a link checker, a monitor — can tell. *@

<main class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="font-display text-3xl text-ink">Page not found</h1>

    <p class="mt-4 text-ink-muted">
        There is nothing published at this address. It may have moved, or never existed.
    </p>

    <p class="mt-8 text-ink-muted">
        <a class="text-accent underline" href="/">Back to the shop</a>
    </p>
</main>
