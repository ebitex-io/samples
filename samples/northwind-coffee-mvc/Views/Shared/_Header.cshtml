@model ComponentValue
@{
    // The header is a Component: one `links` field, each entry a nav link with a `link` and a `label`.
    var links = (Model is { IsResolved: true } ? Model.Content : null).Components("links");
}

<header class="border-b border-line">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-5">
        <a class="font-display text-xl text-ink" href="/">Northwind Coffee</a>

        <nav aria-label="Primary">
            <ul class="flex flex-wrap gap-5 text-sm">
                @foreach (var entry in links)
                {
                    var fields = entry.IsResolved ? entry.Content : null;
                    var label = fields.Text("label");

                    @* A nav link whose target is unpublished has a null url. It is dropped rather than
                       rendered dead: the CMS already answered the question, and a link that goes
                       nowhere is worse than one that is absent. *@
                    if (label is { Length: > 0 } && fields.Link("link")?.Url is { Length: > 0 } href)
                    {
                        <li><a class="text-ink-muted hover:text-ink" href="@href">@label</a></li>
                    }
                }
            </ul>
        </nav>
    </div>
</header>
