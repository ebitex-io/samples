<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>863a7346-2d75-4604-b957-d55c02c5564b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ebitex.Content.Delivery" Version="0.2.5" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <!--
    The test project lives under tests/, inside this project's own directory, and the SDK's default
    globs are recursive - so without this the web project compiles the test project's sources into
    itself. It fails in a thoroughly misleading way: the first error is "the type or namespace name
    'Xunit' could not be found", reported against THIS project, which has no business knowing what
    xunit is.
  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

</Project>
