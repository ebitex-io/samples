# The delivery key. Unlike the static sample's VITE_CONTENT_DELIVERY_KEY, this never reaches the
# browser -- so it does NOT need to be browser-safe (origin- or IP-restricted). That difference is
# the main thing a server buys you, and it is why this variable has no NEXT_PUBLIC_ prefix.
CONTENT_DELIVERY_KEY=

# Your site's root node id. Optional if your organization has exactly one published site.
CONTENT_SITE_ID=

# Only needed against a non-production API (a local AppHost, say).
# CONTENT_API_BASE_URL=

# This SITE's own public origin -- https://northwind.example, not the API's host and not the
# container's. It is what makes a canonical link, an og:image and the sitemap reference in
# robots.txt absolute, which all three have to be.
#
# Required rather than optional: `app/robots.ts` is handed no request by Next, so unlike
# `app/sitemap.xml/route.ts` it has nothing to derive an origin from. Behind a proxy neither could
# use the socket's host anyway -- that is the load balancer's, not yours.
SITE_ORIGIN=

# These two DO reach the browser -- they build the src of an iframe the visitor loads -- so they
# are public by construction and named with Next's NEXT_PUBLIC_ prefix. Contrast with
# CONTENT_DELIVERY_KEY above, which has no prefix and lives behind `import 'server-only'`.
NEXT_PUBLIC_FORMS_BASE_URL=
NEXT_PUBLIC_FORMS_ORG_SLUG=

# Which window may drive live preview, comma separated. Defaults to https://content.ebitex.io.
# Set this when running Content locally, e.g. http://localhost:5175.
NEXT_PUBLIC_PREVIEW_ORIGINS=
