      {
        "id": "9ffbdb73-7a9f-4ac5-948b-9754aa7d7e22",
        "externalId": "card-sections",
        "name": "Card: sections",
        "folderId": null,
        "contractId": "a2595de9-6cfa-408f-baa7-df6541a4a588",
        "document": "{\"title\":{\"default\":\"Sections\",\"locales\":{}},\"summary\":{\"default\":\"Hero, rich text, media, card, feature, banner, call to action, tabs, accordion and grid.\",\"locales\":{}},\"action\":{\"mode\":\"inline\",\"contract\":\"37ea6f35-8401-4324-81ba-5f8aa6a9dd3c\",\"contractVersion\":1,\"document\":{\"label\":{\"default\":\"Read more\",\"locales\":{}},\"href\":{\"kind\":\"external\",\"url\":\"https://ebitex.io\"},\"style\":\"link\"}}}",
