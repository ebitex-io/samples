      {
        "id": "b4820cfa-1d3f-4c87-b63e-b2547707a7fd",
        "externalId": "card-hero",
        "name": "Card: pages",
        "folderId": null,
        "contractId": "e48698be-d321-41c3-bdb2-81a7d0580940",
        "document": "{\"title\":{\"default\":\"Pages\",\"locales\":{}},\"summary\":{\"default\":\"A page is a hero and a list of sections, each one a presentation from the kit.\",\"locales\":{}},\"action\":{\"mode\":\"inline\",\"contract\":\"5b35684f-4fc4-433e-b027-1e37fbc90879\",\"contractVersion\":1,\"document\":{\"label\":{\"default\":\"Read more\",\"locales\":{}},\"href\":{\"kind\":\"external\",\"url\":\"https://ebitex.io\"},\"style\":\"link\"}}}",
