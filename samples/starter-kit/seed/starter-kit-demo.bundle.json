      {
        "id": "5eb2e0da-8697-446b-8a98-068055c18fef",
        "externalId": "card-themes",
        "name": "Card: themes",
        "folderId": null,
        "contractId": "a2595de9-6cfa-408f-baa7-df6541a4a588",
        "document": "{\"title\":{\"default\":\"Themes\",\"locales\":{}},\"summary\":{\"default\":\"Colour tokens as CSS variables, with a light and a dark set that follow the reader.\",\"locales\":{}},\"action\":{\"mode\":\"inline\",\"contract\":\"37ea6f35-8401-4324-81ba-5f8aa6a9dd3c\",\"contractVersion\":1,\"document\":{\"label\":{\"default\":\"Read more\",\"locales\":{}},\"href\":{\"kind\":\"external\",\"url\":\"https://ebitex.io\"},\"style\":\"link\"}}}",
        "categoryIds": [],
        "isRoot": true
      },
      {
        "id": "b47b6617-de26-4684-ae3f-a470c91f73eb",
        "externalId": "rich-intro",
        "name": "Introduction",
        "folderId": null,
        "contractId": "c1d4d1b7-20c9-4af5-b2b5-8168540216ac",
        "document": "{\"body\":{\"default\":{\"markdown\":\"## Built from reusable parts\\n\\nThe words live in Components. **How** a section looks is chosen where it is placed, so one Component can appear in many places in different ways.\\n\\n- Change a heading once and every page that uses it follows.\\n- Choose the width, the background and the layout per placement.\\n- Keep your own content in your own realm; the kit stays read-only.\"},\"locales\":{}}}",
        "categoryIds": [],
        "isRoot": true
      },
      {
        "id": "fb471b96-94dd-4a7a-918e-50569b85fe6e",
        "externalId": "tab-overview",
        "name": "Tab: overview",
        "folderId": null,
        "contractId": "c1d4d1b7-20c9-4af5-b2b5-8168540216ac",
        "document": "{\"body\":{\"default\":{\"markdown\":\"The kit gives every site the same starting vocabulary. Pages, sections and actions are ordinary Contracts, so nothing here is special to the renderer.\"},\"locales\":{}}}",
        "categoryIds": [],
        "isRoot": true
      },
      {
        "id": "21035f87-99f0-4611-8102-67766fa94add",
        "externalId": "tab-details",
        "name": "Tab: details",
        "folderId": null,
        "contractId": "c1d4d1b7-20c9-4af5-b2b5-8168540216ac",
        "document": "{\"body\":{\"default\":{\"markdown\":\"A renderer reads the Contract of each section and draws it. This sample draws all ten presentations in a light and a dark theme.\\n\\n| Presentation | Draws |\\n|---|---|\\n| Hero | a heading, a lead and up to two actions |\\n| Grid | its items in a chosen number of columns |\"},\"locales\":{}}}",
        "categoryIds": [],
        "isRoot": true
      },
      {
        "id": "db6346e3-0dbe-4ff9-b6cc-5ad03ec85ab2",
        "externalId": "tabs-main",
        "name": "Tabs",
