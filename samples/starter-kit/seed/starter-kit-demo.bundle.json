      {
        "id": "b4820cfa-1d3f-4c87-b63e-b2547707a7fd",
        "externalId": "card-hero",
        "name": "Card: pages",
        "folderId": null,
        "contractId": "a2595de9-6cfa-408f-baa7-df6541a4a588",
        "document": "{\"title\":{\"default\":\"Pages\",\"locales\":{}},\"summary\":{\"default\":\"A page is a hero and a list of sections, each one a presentation from the kit.\",\"locales\":{}},\"action\":{\"mode\":\"inline\",\"contract\":\"37ea6f35-8401-4324-81ba-5f8aa6a9dd3c\",\"contractVersion\":1,\"document\":{\"label\":{\"default\":\"Read more\",\"locales\":{}},\"href\":{\"kind\":\"external\",\"url\":\"https://ebitex.io\"},\"style\":\"link\"}}}",
