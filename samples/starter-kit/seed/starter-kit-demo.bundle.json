        "contractId": "e48698be-d321-41c3-bdb2-81a7d0580940",
        "document": "{\"title\":{\"default\":\"Themes\",\"locales\":{}},\"summary\":{\"default\":\"Colour tokens as CSS variables, with a light and a dark set that follow the reader.\",\"locales\":{}},\"action\":{\"mode\":\"inline\",\"contract\":\"5b35684f-4fc4-433e-b027-1e37fbc90879\",\"contractVersion\":1,\"document\":{\"label\":{\"default\":\"Read more\",\"locales\":{}},\"href\":{\"kind\":\"external\",\"url\":\"https://ebitex.io\"},\"style\":\"link\"}}}",
