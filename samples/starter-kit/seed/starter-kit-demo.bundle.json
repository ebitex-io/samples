        "contractId": "09242c2d-6954-4e7f-93a0-e01d75ff2ff0",
        "document": "{\"items\":[{\"mode\":\"reference\",\"provider\":\"core\",\"key\":\"fb471b96-94dd-4a7a-918e-50569b85fe6e\",\"contextualValues\":{\"itemLabel\":{\"default\":\"Overview\",\"locales\":{}}}},{\"mode\":\"reference\",\"provider\":\"core\",\"key\":\"21035f87-99f0-4611-8102-67766fa94add\",\"contextualValues\":{\"itemLabel\":{\"default\":\"Details\",\"locales\":{}}}}]}",
        "categoryIds": [],
        "isRoot": true
      },
      {
        "id": "fc03b834-b4bf-4470-86b0-cda7ca093fc6",
        "externalId": "faq-reuse",
        "name": "FAQ: reuse",
        "folderId": null,
        "contractId": "da089887-a8e0-4a45-a21d-be30a69b366d",
        "document": "{\"body\":{\"default\":{\"markdown\":\"Yes. The same Component can be placed several times; each placement chooses its own width, background, tone or layout.\"},\"locales\":{}}}",
        "categoryIds": [],
        "isRoot": true
      },
      {
        "id": "5e1bb17d-889e-4ff6-b23b-ad251343ecc3",
        "externalId": "faq-fork",
