# Your own Content delivery key. Create one in Content -> Configure -> Delivery, in an
# ebitex organization that has opted in to the starter kit (Content -> Settings -> Realms).
#
# For local development an unrestricted key is fine. For a deployed site use a BROWSER-SAFE
# key restricted to your own origin: the key ships inside the JavaScript bundle.
VITE_CONTENT_DELIVERY_KEY=

# Optional. Defaults to the ebitex production API (https://api.ebitex.io).
# VITE_CONTENT_API_BASE_URL=

# Optional. Pin the site so the SDK skips its discovery call on first load.
# VITE_CONTENT_SITE_ID=
